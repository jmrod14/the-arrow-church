#!/bin/sh
set -eu

repository=/home/admin/repos/the-arrow-church.git
target=/var/www/html/wp-content/themes/the-arrow-church

deploy_main() {
    newrev=$1
    stage=$(mktemp -d)
    case "$stage" in /tmp/tmp.*) ;; *) echo 'Unexpected staging path' >&2; exit 1 ;; esac
    trap 'rm -rf "$stage"' EXIT HUP INT TERM
    git --git-dir="$repository" archive "$newrev" | tar -x -C "$stage"
    php -l "$stage/functions.php"
    php -l "$stage/inc/site-photos.php"
    php -l "$stage/inc/staff.php"
    php -l "$stage/front-page.php"
    php -l "$stage/index.php"
    php -l "$stage/page.php"
    php -l "$stage/pages/data.php"
    php -l "$stage/pages/content.php"
    php -l "$stage/deploy/sync-pages.php"
    [ ! -L "$target" ] || { echo 'Refusing symlinked theme target' >&2; exit 1; }
    mkdir -p "$target"
    rsync -a --delete --exclude '/deploy/' --exclude '/README.md' --exclude '/tools/' "$stage/" "$target/"
    chmod -R a+rX "$target"
    wp eval-file "$stage/deploy/sync-pages.php" --path=/var/www/html
    wp rewrite structure '/%postname%/' --path=/var/www/html
    if [ ! -e /var/www/html/.htaccess ]; then
        cp "$stage/deploy/wordpress.htaccess" /var/www/html/.htaccess
        chmod 664 /var/www/html/.htaccess
    fi
    echo "Deployed The Arrow Church theme at $newrev"
    rm -rf "$stage"
    trap - EXIT HUP INT TERM
}

if [ "${1-}" = main ]; then
    deploy_main "$(git --git-dir="$repository" rev-parse refs/heads/main)"
else
    while read -r oldrev newrev refname; do
        [ "$refname" = refs/heads/main ] || continue
        deploy_main "$newrev"
    done
fi
