#!/bin/sh
set -eu

repository=/home/admin/repos/the-arrow-church.git
target=/var/www/html/wp-content/themes/the-arrow-church

while read -r oldrev newrev refname; do
    [ "$refname" = refs/heads/main ] || continue
    stage=$(mktemp -d)
    trap 'rm -rf "$stage"' EXIT HUP INT TERM
    git --git-dir="$repository" archive "$newrev" | tar -x -C "$stage"
    php -l "$stage/functions.php"
    php -l "$stage/front-page.php"
    php -l "$stage/index.php"
    [ ! -L "$target" ] || { echo 'Refusing symlinked theme target' >&2; exit 1; }
    mkdir -p "$target"
    rsync -a --delete --exclude '/deploy/' --exclude '/README.md' "$stage/" "$target/"
    echo "Deployed The Arrow Church theme at $newrev"
    rm -rf "$stage"
    trap - EXIT HUP INT TERM
done
